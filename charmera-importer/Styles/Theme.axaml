<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Default ("Classic") palette: Kodak red accent, near-black header, clean light surfaces. Once the
       user picks their camera, Services/AppTheme.cs replaces the themed brushes (Accent*, OnAccent,
       Header*, OnHeader*, SurfaceApp, Tint*) at runtime; they are referenced with DynamicResource.
       Status colors are fixed on purpose —
       Converters/ImportStatusToBrushConverter.cs mirrors StatusImported/Duplicate/Error/Pending. -->
  <Styles.Resources>
    <ResourceDictionary>
      <Color x:Key="AccentColor">#ED1C24</Color>
      <Color x:Key="AccentHoverColor">#D4151C</Color>
      <Color x:Key="AccentPressedColor">#B01015</Color>
      <Color x:Key="KodakYellowColor">#FFC72C</Color>
      <Color x:Key="DangerColor">#DC2626</Color>

      <Color x:Key="InkPrimaryColor">#1A1A1E</Color>
      <Color x:Key="InkSecondaryColor">#6B7280</Color>
      <Color x:Key="InkTertiaryColor">#9CA3AF</Color>

      <Color x:Key="SurfaceAppColor">#F3F3F5</Color>
      <Color x:Key="SurfaceCardColor">#FFFFFF</Color>
      <Color x:Key="HeaderColor">#17181B</Color>

      <Color x:Key="BorderSubtleColor">#E4E4E7</Color>
      <Color x:Key="BorderStrongColor">#D4D4D8</Color>

      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
      <SolidColorBrush x:Key="KodakYellowBrush" Color="{StaticResource KodakYellowColor}" />
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

      <SolidColorBrush x:Key="InkPrimaryBrush" Color="{StaticResource InkPrimaryColor}" />
      <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
      <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiaryColor}" />

      <SolidColorBrush x:Key="SurfaceAppBrush" Color="{StaticResource SurfaceAppColor}" />
      <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
      <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="White" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="OnHeaderBrush" Color="White" />
      <SolidColorBrush x:Key="OnHeaderMutedBrush" Color="#9A9AA2" />
      <SolidColorBrush x:Key="HeaderHoverBrush" Color="#22FFFFFF" />
      <SolidColorBrush x:Key="HeaderPressedBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="TintBrush" Color="#FFF4D6" />
      <SolidColorBrush x:Key="TintBorderBrush" Color="#F5D98B" />

      <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Primary CTA button (Import) -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="20,15" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BorderStrongBrush}" />
  </Style>

  <!-- Secondary / outline button -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceAppBrush}" />
  </Style>

  <!-- Small square icon button (refresh) -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#33FFFFFF" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
  </Style>

  <!-- Form controls -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}" />
  </Style>

  <!-- Section labels in the sidebar -->
  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
  </Style>

  <!-- Compact variant of the secondary button, for inline actions ("Change") -->
  <Style Selector="Button.secondary.compact">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Icon-only button on the dark app bar (settings) -->
  <Style Selector="Button.appBarIcon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.appBarIcon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HeaderHoverBrush}" />
  </Style>
  <Style Selector="Button.appBarIcon:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HeaderPressedBrush}" />
  </Style>

  <!-- Icon-only button on light surfaces (refresh devices, close details) -->
  <Style Selector="Button.surfaceIcon">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.surfaceIcon.small">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.surfaceIcon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceAppBrush}" />
  </Style>

  <!-- Line icons (Path) share one stroke language -->
  <Style Selector="Path.lineIcon">
    <Setter Property="Stroke" Value="{StaticResource InkPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <!-- Workflow steps: numbered badge that turns into a red check once the step is complete -->
  <Style Selector="Border.stepBadge">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Border.stepBadge.done">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.stepBadge TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.stepConnector">
    <Setter Property="Width" Value="1.5" />
    <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,6" />
  </Style>
  <Style Selector="TextBlock.stepTitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Typography helpers -->
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Destination path + example path boxes -->
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource SurfaceAppBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, Noto Sans Mono, DejaVu Sans Mono, Liberation Mono, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- "Kodak Charmera" call-outs: a soft tint of the camera's color -->
  <Style Selector="Border.charmeraBadge">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TintBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- Settings popover -->
  <Style Selector="FlyoutPresenter.settings">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MaxWidth" Value="400" />
  </Style>

  <!-- Camera picker: the seven Charmeras as a compact grid; the chosen one gets an accent ring. -->
  <Style Selector="ListBox.cameraPicker">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.cameraPicker ListBoxItem">
    <Setter Property="Padding" Value="5" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.cameraPicker ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.cameraPicker ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceAppBrush}" />
  </Style>
  <Style Selector="ListBox.cameraPicker ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- Thumbnail grid: strip the default Fluent selection/hover chrome so our own
       card border (see MainWindow.axaml "photoCard" Border) provides the highlight. -->
  <Style Selector="ListBox.photoGrid">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.photoGrid ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="ListBox.photoGrid ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.photoGrid ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.photoCard">
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.photoCard">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentInkBrush}" />
    <Setter Property="BorderThickness" Value="2.5" />
  </Style>

</Styles>
