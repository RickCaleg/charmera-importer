<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:charmera_importer.ViewModels"
        xmlns:models="using:charmera_importer.Models"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:c="using:charmera_importer.Converters"
        xmlns:loc="using:charmera_importer.Localization"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="charmera_importer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/charmera-icon.ico"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceAppBrush}"
        Title="Charmera Importer">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!--
      Layout, top to bottom / left to right:
        App bar      brand + settings (language, updates, version: everything that isn't importing)
        Update bar   only when a newer release exists
        Workflow     the import task as three ordered steps (Camera -> Destination -> After import)
                     with the primary action pinned at the bottom
        Photos       what's on the camera; the empty state explains what to do next
        Details      EXIF of the selected photo
    -->
    <DockPanel>

        <!-- App bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceHeaderBrush}" Height="64">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,0,16,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource KodakRedBrush}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="CHARMERA" FontSize="19" FontWeight="Bold" Foreground="White"
                               LetterSpacing="2" VerticalAlignment="Center" />
                    <TextBlock Text="Kodak Photo Importer" FontSize="13" Foreground="#9A9AA2"
                               VerticalAlignment="Center" Margin="4,2,0,0" />
                </StackPanel>

                <Button Grid.Column="2" x:Name="SettingsButton" Classes="appBarIcon" VerticalAlignment="Center"
                        ToolTip.Tip="{loc:Loc SettingsTitle}">
                    <PathIcon Width="20" Height="20" Foreground="#D4D4D8"
                              Data="M19.32,9.97 L21.87,10.39 L21.87,13.61 L19.32,14.03 L18.61,15.75 L20.12,17.84 L17.84,20.12 L15.75,18.61 L14.03,19.32 L13.61,21.87 L10.39,21.87 L9.97,19.32 L8.25,18.61 L6.16,20.12 L3.88,17.84 L5.39,15.75 L4.68,14.03 L2.13,13.61 L2.13,10.39 L4.68,9.97 L5.39,8.25 L3.88,6.16 L6.16,3.88 L8.25,5.39 L9.97,4.68 L10.39,2.13 L13.61,2.13 L14.03,4.68 L15.75,5.39 L17.84,3.88 L20.12,6.16 L18.61,8.25 Z M15.2,12 A3.2,3.2 0 1 0 8.8,12 A3.2,3.2 0 1 0 15.2,12 Z" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="settings">
                            <StackPanel Width="320" x:DataType="vm:MainViewModel">
                                <TextBlock Text="{loc:Loc SettingsTitle}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource InkPrimaryBrush}" Margin="20,18,20,14" />

                                <StackPanel Spacing="8" Margin="20,0,20,18">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Loc SettingsLanguage}" />
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="loc:LanguageOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" />

                                <StackPanel Spacing="10" Margin="20,16,20,18">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Loc SettingsUpdates}" />
                                    <CheckBox Content="{loc:Loc UpdateAutoCheck}"
                                              IsChecked="{Binding CheckForUpdatesAutomatically}" />
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Button Grid.Column="0" Classes="secondary compact"
                                                Content="{loc:Loc UpdateCheckButton}"
                                                Command="{Binding CheckForUpdatesCommand}" />
                                        <TextBlock Grid.Column="1" Classes="caption" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding UpdateStatusMessage}" />
                                    </Grid>
                                </StackPanel>

                                <Border Background="{StaticResource SurfaceAppBrush}" CornerRadius="0,0,12,12"
                                        Padding="20,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                                   Text="{Binding CurrentVersionLabel}" />
                                        <Button Grid.Column="1" Classes="secondary compact"
                                                Content="{loc:Loc SettingsAbout}" Click="OnAboutClicked" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- Update bar -->
        <Border DockPanel.Dock="Top" Background="#FFF4D6" BorderBrush="#F5D98B" BorderThickness="0,0,0,1"
                Padding="24,10" IsVisible="{Binding ShowUpdateBanner}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#D99A00"
                        VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding UpdateBannerText}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource InkPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc UpdateManualNote}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{StaticResource InkSecondaryBrush}" IsVisible="{Binding IsManualUpdate}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsInstallingUpdate}">
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpdateDownloadProgress}" Width="240"
                                     VerticalAlignment="Center" />
                        <TextBlock Classes="caption" Text="{Binding UpdateStatusMessage}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" Text="{Binding UpdateStatusMessage}"
                               IsVisible="{Binding !IsInstallingUpdate}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Button Classes="secondary compact" Content="{loc:Loc UpdateReleaseNotesButton}"
                            Command="{Binding OpenReleaseNotesCommand}" />
                    <Button Classes="primary" Padding="16,7" FontSize="13" CornerRadius="8"
                            Content="{Binding UpdateActionLabel}" Command="{Binding InstallUpdateCommand}" />
                    <Button Classes="surfaceIcon small" Background="Transparent" BorderThickness="0"
                            Command="{Binding DismissUpdateCommand}" IsEnabled="{Binding !IsInstallingUpdate}"
                            ToolTip.Tip="{loc:Loc UpdateDismissTooltip}">
                        <Path Classes="lineIcon" Width="10" Height="10" Data="M1,1 L11,11 M11,1 L1,11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workflow panel -->
        <Border DockPanel.Dock="Left" Width="360" Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="*,Auto">

                <ScrollViewer Grid.Row="0">
                    <StackPanel Margin="24,24,24,12">

                        <!-- Step 1: Camera -->
                        <Grid ColumnDefinitions="26,*" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Grid.Column="0" Classes="stepBadge"
                                    Classes.done="{Binding IsSourceStepDone}">
                                <Panel>
                                    <TextBlock Text="1" IsVisible="{Binding !IsSourceStepDone}" />
                                    <Path Width="11" Height="9" Stretch="Uniform" Stroke="White" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeJoin="Round" Data="M1,5 L4.5,8.5 L11,1"
                                          IsVisible="{Binding IsSourceStepDone}" />
                                </Panel>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="stepTitle" Margin="12,0,0,0"
                                       Text="{loc:Loc StepSource}" />
                            <Border Grid.Row="1" Grid.Column="0" Classes="stepConnector" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,12,0,28" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding Devices}"
                                              SelectedItem="{Binding SelectedDevice}"
                                              PlaceholderText="{loc:Loc DevicePlaceholder}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:RemovableDevice">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Classes="surfaceIcon" Margin="8,0,0,0"
                                            Command="{Binding RefreshDevicesCommand}"
                                            ToolTip.Tip="{loc:Loc RefreshTooltip}">
                                        <Path Classes="lineIcon" Width="16" Height="16"
                                              Data="M20,12 A8,8 0 1 1 17.66,6.34 M18,2.5 L18,6.5 L14,6.5" />
                                    </Button>
                                </Grid>
                                <TextBlock Classes="caption" Text="{Binding SourceSummary}" />
                                <Border Classes="charmeraBadge" IsVisible="{Binding IsCharmeraDetected}"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource KodakRedBrush}"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc SourceCharmeraDetected}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Step 2: Destination -->
                        <Grid ColumnDefinitions="26,*" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Grid.Column="0" Classes="stepBadge"
                                    Classes.done="{Binding IsDestinationStepDone}">
                                <Panel>
                                    <TextBlock Text="2" IsVisible="{Binding !IsDestinationStepDone}" />
                                    <Path Width="11" Height="9" Stretch="Uniform" Stroke="White" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeJoin="Round" Data="M1,5 L4.5,8.5 L11,1"
                                          IsVisible="{Binding IsDestinationStepDone}" />
                                </Panel>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="stepTitle" Margin="12,0,0,0"
                                       Text="{loc:Loc StepDestination}" />
                            <Border Grid.Row="1" Grid.Column="0" Classes="stepConnector" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,12,0,28" Spacing="16">

                                <!-- Folder: a big "choose" button until one is picked, then path + Change -->
                                <Button Classes="secondary" HorizontalAlignment="Stretch"
                                        IsVisible="{Binding !HasDestination}" Click="OnBrowseDestinationClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="lineIcon" Width="16" Height="14"
                                              Data="M3,7 A2,2 0 0 1 5,5 L9,5 L11,7 L19,7 A2,2 0 0 1 21,9 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 Z" />
                                        <TextBlock Text="{loc:Loc BrowseButton}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Classes="inset" IsVisible="{Binding HasDestination}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Path Grid.Column="0" Classes="lineIcon" Width="16" Height="14"
                                              VerticalAlignment="Center" Stroke="{StaticResource InkSecondaryBrush}"
                                              Data="M3,7 A2,2 0 0 1 5,5 L9,5 L11,7 L19,7 A2,2 0 0 1 21,9 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 Z" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Spacing="1"
                                                    ToolTip.Tip="{Binding DestinationRootPathDisplay}">
                                            <TextBlock Text="{Binding DestinationFolderName}" FontSize="13.5"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource InkPrimaryBrush}" />
                                            <TextBlock Text="{Binding DestinationRootPathDisplay}" FontSize="11.5"
                                                       TextTrimming="PrefixCharacterEllipsis"
                                                       Foreground="{StaticResource InkSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="secondary compact"
                                                Content="{loc:Loc DestChangeButton}" VerticalAlignment="Center"
                                                Click="OnBrowseDestinationClicked" />
                                    </Grid>
                                </Border>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Loc OrganizeLabel}" />
                                    <ComboBox ItemsSource="{Binding OrganizationOptions}"
                                              SelectedItem="{Binding SelectedOrganizationOption}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:FolderOrganizationOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Loc NamingLabel}" />
                                    <ComboBox ItemsSource="{Binding NamingPresets}"
                                              SelectedItem="{Binding SelectedNamingPreset}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:NamingPresetOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Content="{loc:Loc KeepOriginalName}"
                                              IsChecked="{Binding AppendOriginalFileName}" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <CheckBox Content="{loc:Loc DestRepairCharmera}"
                                              IsChecked="{Binding RepairCharmeraMetadata}" />
                                    <TextBlock Classes="caption" FontSize="12" Margin="28,0,0,0"
                                               Text="{loc:Loc DestRepairCharmeraHint}" />
                                </StackPanel>

                                <!-- Live consequence of the choices above -->
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="fieldLabel" Text="{loc:Loc DestPreviewLabel}" />
                                    <Border Classes="inset">
                                        <TextBlock Classes="mono" Text="{Binding DestinationPreview}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Step 3: After import -->
                        <Grid ColumnDefinitions="26,*" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Grid.Column="0" Classes="stepBadge">
                                <TextBlock Text="3" />
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="stepTitle" Margin="12,0,0,0"
                                       Text="{loc:Loc StepAfterImport}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,12,0,8" Spacing="6">
                                <CheckBox Content="{loc:Loc DeleteAfterImport}"
                                          IsChecked="{Binding DeleteSourceAfterImport}" />
                                <TextBlock Text="{loc:Loc DeleteAfterImportWarning}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource KodakRedBrush}" Margin="28,0,0,0"
                                           IsVisible="{Binding DeleteSourceAfterImport}" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- Primary action, always visible -->
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                        Padding="24,18,24,22">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="8" IsVisible="{Binding IsImporting}">
                            <ProgressBar Minimum="0" Maximum="{Binding ImportProgressTotal}"
                                         Value="{Binding ImportProgressCurrent}" />
                        </StackPanel>
                        <TextBlock Classes="caption" Text="{Binding StatusMessage}"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <Button Classes="primary" HorizontalAlignment="Stretch" Content="{Binding ImportButtonLabel}"
                                Command="{Binding ImportCommand}" />
                        <TextBlock Classes="caption" TextAlignment="Center" Text="{Binding ImportHint}"
                                   IsVisible="{Binding ShowImportHint}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Photos + details -->
        <Grid ColumnDefinitions="*,Auto">

            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Margin="28,22,28,6" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{loc:Loc PhotosTitle}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource InkPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedDevice.DisplayName, FallbackValue=''}" FontSize="13"
                                   Foreground="{StaticResource InkTertiaryBrush}" VerticalAlignment="Center"
                                   Margin="0,3,0,0" IsVisible="{Binding HasDevice}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding PhotosCountLabel}" FontSize="13"
                               Foreground="{StaticResource InkSecondaryBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding HasDevice}" />
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer>
                        <ListBox Classes="photoGrid" ItemsSource="{Binding Photos}"
                                 SelectedItem="{Binding SelectedPhoto}" Padding="20,8,20,20">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PhotoItemViewModel">
                                    <Border Classes="photoCard" Width="188" Margin="8"
                                            CornerRadius="14" Background="{StaticResource SurfaceCardBrush}"
                                            BoxShadow="0 1 4 0 #14000000">
                                        <Grid RowDefinitions="146,Auto" Margin="12">
                                            <Grid Grid.Row="0">
                                                <Border CornerRadius="9" Background="{StaticResource SurfaceAppBrush}"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="6" Padding="9,3" CornerRadius="10"
                                                        IsVisible="{Binding HasStatusBadge}"
                                                        Background="{Binding Status, Converter={x:Static c:ImportStatusToBrushConverter.Instance}}">
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,9,0,0" Spacing="2">
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource InkPrimaryBrush}" />
                                                <TextBlock Text="{Binding CameraModel}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding HasCameraModel}"
                                                           Foreground="{StaticResource InkSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Empty states: each one says what to do next -->
                    <StackPanel IsVisible="{Binding ShowNoDeviceState}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="10" MaxWidth="340">
                        <Border Width="72" Height="72" CornerRadius="36" Background="White"
                                HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Path Classes="lineIcon" Width="32" Height="28" Stroke="{StaticResource InkSecondaryBrush}"
                                  Data="M4,7.5 L7,7.5 L8.5,5.5 L15.5,5.5 L17,7.5 L20,7.5 A1.5,1.5 0 0 1 21.5,9 L21.5,18 A1.5,1.5 0 0 1 20,19.5 L4,19.5 A1.5,1.5 0 0 1 2.5,18 L2.5,9 A1.5,1.5 0 0 1 4,7.5 Z M15.5,13.5 A3.5,3.5 0 1 0 8.5,13.5 A3.5,3.5 0 1 0 15.5,13.5 Z" />
                        </Border>
                        <TextBlock Text="{loc:Loc EmptyNoDeviceTitle}" FontSize="16" FontWeight="SemiBold"
                                   TextAlignment="Center" Foreground="{StaticResource InkPrimaryBrush}" />
                        <TextBlock Classes="caption" Text="{loc:Loc EmptyNoDeviceSubtitle}" FontSize="13"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowScanningState}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="14" Width="240">
                        <ProgressBar IsIndeterminate="True" Height="4" />
                        <TextBlock Classes="caption" Text="{loc:Loc ScanningStatus}" FontSize="13"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowNoPhotosState}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="10" MaxWidth="340">
                        <Border Width="72" Height="72" CornerRadius="36" Background="White"
                                HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Path Classes="lineIcon" Width="30" Height="26" Stroke="{StaticResource InkSecondaryBrush}"
                                  Data="M4,5 L20,5 A1,1 0 0 1 21,6 L21,18 A1,1 0 0 1 20,19 L4,19 A1,1 0 0 1 3,18 L3,6 A1,1 0 0 1 4,5 Z M3.5,16 L8.5,11 L12.5,15 L15.5,12 L20.5,17 M17,8.5 A1.5,1.5 0 1 0 14,8.5 A1.5,1.5 0 1 0 17,8.5 Z" />
                        </Border>
                        <TextBlock Text="{loc:Loc EmptyNoPhotosTitle}" FontSize="16" FontWeight="SemiBold"
                                   TextAlignment="Center" Foreground="{StaticResource InkPrimaryBrush}" />
                        <TextBlock Classes="caption" Text="{loc:Loc EmptyNoPhotosSubtitle}" FontSize="13"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Width="320" IsVisible="{Binding SelectedPhoto, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                    Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,18,16,0">
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{loc:Loc DetailTitle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="surfaceIcon small" Background="Transparent" BorderThickness="0"
                                Command="{Binding CloseDetailsCommand}" ToolTip.Tip="{loc:Loc DetailCloseTooltip}">
                            <Path Classes="lineIcon" Width="10" Height="10" Data="M1,1 L11,11 M11,1 L1,11" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="24,8,24,24" Spacing="6" DataContext="{Binding SelectedPhoto}" x:DataType="vm:PhotoItemViewModel">
                            <Border CornerRadius="10" ClipToBounds="True" Background="{StaticResource SurfaceAppBrush}"
                                    Height="180" Margin="0,0,0,10">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasCameraMake}">
                                <TextBlock Text="{loc:Loc DetailMake}" FontSize="13" Width="90" Foreground="{StaticResource InkSecondaryBrush}" />
                                <TextBlock Text="{Binding CameraMake}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasCameraModel}">
                                <TextBlock Text="{loc:Loc DetailModel}" FontSize="13" Width="90" Foreground="{StaticResource InkSecondaryBrush}" />
                                <TextBlock Text="{Binding CameraModel}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasDateTaken}">
                                <TextBlock Text="{loc:Loc DetailDate}" FontSize="13" Width="90" Foreground="{StaticResource InkSecondaryBrush}" />
                                <TextBlock Text="{Binding DateTakenDisplay}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasDimensions}">
                                <TextBlock Text="{loc:Loc DetailDimensions}" FontSize="13" Width="90" Foreground="{StaticResource InkSecondaryBrush}" />
                                <TextBlock Text="{Binding Width, StringFormat='{}{0}px'}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkPrimaryBrush}" />
                                <TextBlock Text="×" FontSize="13" Foreground="{StaticResource InkSecondaryBrush}" />
                                <TextBlock Text="{Binding Height, StringFormat='{}{0}px'}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkPrimaryBrush}" />
                            </StackPanel>
                            <Border Classes="charmeraBadge" IsVisible="{Binding IsCharmera}" Margin="0,4,0,4">
                                <TextBlock Text="{loc:Loc DetailCharmeraNote}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource InkPrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{loc:Loc DetailNoExifNote}"
                                       FontSize="12.5" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkTertiaryBrush}"
                                       IsVisible="{Binding !HasAnyBasicExifInfo}" />

                            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,14" />

                            <!-- The raw tag dump is for the curious; collapsed so the key facts above lead -->
                            <Expander HorizontalAlignment="Stretch" Padding="12,8">
                                <Expander.Header>
                                    <TextBlock Classes="fieldLabel" Text="{loc:Loc DetailAllTags}" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding AllTags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11.5"
                                                       Foreground="{StaticResource InkSecondaryBrush}" Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>

</Window>
