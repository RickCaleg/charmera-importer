# Maintainer: Richardson Calegari Saconi <https://github.com/RickCaleg>
#
# Packages the prebuilt Linux release (self-contained .NET, no runtime to install). The
# easiest way to use it is packaging/arch/install.sh, which fills in the latest version and
# its checksum from the release's SHA256SUMS; to build this file by hand: `makepkg -si`.

pkgname=charmera-importer-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Photo and video importer for the Kodak Charmera that repairs the camera's broken metadata"
arch=('x86_64')
url="https://github.com/RickCaleg/charmera-importer"
license=('MIT')
# .NET needs glibc/libstdc++, ICU and OpenSSL (for HTTPS); the Avalonia UI needs fontconfig
# and X11 (it runs through XWayland on Wayland desktops).
depends=('glibc' 'gcc-libs' 'icu' 'openssl' 'fontconfig' 'libx11' 'libice' 'libsm' 'libxi' 'libxrandr' 'libxcursor')
provides=('charmera-importer')
conflicts=('charmera-importer')
# A single-file .NET executable carries its app bundle appended to the binary: stripping it
# would corrupt it.
options=('!strip' '!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/charmera-importer-${pkgver}-linux-x64.tar.gz")
sha256sums=('f5d07155639216f287d8dd649bc37e0ce568167951c784d67819bc899eb7f2f4')

package() {
  install -Dm755 charmera-importer "${pkgdir}/opt/charmera-importer/charmera-importer"
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/charmera-importer/charmera-importer "${pkgdir}/usr/bin/charmera-importer"
  install -Dm644 charmera-importer.desktop "${pkgdir}/usr/share/applications/charmera-importer.desktop"
  install -Dm644 charmera-importer.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/charmera-importer.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 THIRD-PARTY-NOTICES.md "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-NOTICES.md"
}
