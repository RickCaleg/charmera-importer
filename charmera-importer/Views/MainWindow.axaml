<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:charmera_importer.ViewModels"
        xmlns:models="using:charmera_importer.Models"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:c="using:charmera_importer.Converters"
        xmlns:loc="using:charmera_importer.Localization"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="charmera_importer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/charmera-icon.ico"
        Width="1440" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceAppBrush}"
        Title="Charmera Importer">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceHeaderBrush}" Height="84">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="28,0">

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Border Width="14" Height="14" CornerRadius="4" Background="{StaticResource KodakRedBrush}"
                            VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="CHARMERA" FontSize="22" FontWeight="Bold" Foreground="White"
                                   LetterSpacing="2" />
                        <TextBlock Text="Kodak Photo Importer" FontSize="12" Foreground="#9A9AA2" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" Margin="0,0,20,0">
                    <TextBlock Text="{loc:Loc LanguageLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#9A9AA2"
                               HorizontalAlignment="Right" />
                    <ComboBox Width="130" ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="loc:LanguageOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{loc:Loc DeviceLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#9A9AA2"
                                   HorizontalAlignment="Right" />
                        <ComboBox Width="240" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                  PlaceholderText="{loc:Loc DevicePlaceholder}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RemovableDevice">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Classes="icon" Content="&#8635;" Command="{Binding RefreshDevicesCommand}"
                            ToolTip.Tip="{loc:Loc RefreshTooltip}" VerticalAlignment="Bottom" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Update banner -->
        <Border DockPanel.Dock="Top" Background="{StaticResource KodakYellowBrush}" Padding="28,10"
                IsVisible="{Binding ShowUpdateBanner}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding UpdateBannerText}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource InkPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc UpdateManualNote}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource InkPrimaryBrush}" IsVisible="{Binding IsManualUpdate}" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpdateDownloadProgress}" MaxWidth="420"
                                 HorizontalAlignment="Left" IsVisible="{Binding IsInstallingUpdate}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Button Classes="secondary" Content="{loc:Loc UpdateReleaseNotesButton}"
                            Command="{Binding OpenReleaseNotesCommand}" />
                    <Button Classes="primary" Content="{Binding UpdateActionLabel}"
                            Command="{Binding InstallUpdateCommand}" />
                    <Button Classes="icon" Content="&#10005;" Command="{Binding DismissUpdateCommand}"
                            ToolTip.Tip="{loc:Loc UpdateDismissTooltip}" IsEnabled="{Binding !IsInstallingUpdate}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="340" Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="28,28" Spacing="24">

                    <StackPanel Spacing="10">
                        <TextBlock Classes="sectionLabel" Text="{loc:Loc DestinationLabel}" />
                        <Border Background="{StaticResource SurfaceAppBrush}" CornerRadius="9" Padding="14,12">
                            <TextBlock Text="{Binding DestinationRootPathDisplay}"
                                       TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource InkPrimaryBrush}" />
                        </Border>
                        <Button Classes="secondary" Content="{loc:Loc BrowseButton}" HorizontalAlignment="Stretch"
                                Click="OnBrowseDestinationClicked" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" />

                    <StackPanel Spacing="10">
                        <TextBlock Classes="sectionLabel" Text="{loc:Loc OrganizeLabel}" />
                        <ComboBox ItemsSource="{Binding OrganizationOptions}"
                                  SelectedItem="{Binding SelectedOrganizationOption}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:FolderOrganizationOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Classes="sectionLabel" Text="{loc:Loc NamingLabel}" />
                        <ComboBox ItemsSource="{Binding NamingPresets}"
                                  SelectedItem="{Binding SelectedNamingPreset}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:NamingPresetOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="{loc:Loc KeepOriginalName}"
                                  IsChecked="{Binding AppendOriginalFileName}" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" />

                    <StackPanel Spacing="6">
                        <CheckBox Content="{loc:Loc DeleteAfterImport}"
                                  IsChecked="{Binding DeleteSourceAfterImport}" />
                        <TextBlock Text="{loc:Loc DeleteAfterImportWarning}" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{StaticResource KodakRedBrush}" Margin="26,0,0,0"
                                   IsVisible="{Binding DeleteSourceAfterImport}" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" />

                    <StackPanel Spacing="12">
                        <Button Classes="primary" Content="{loc:Loc ImportButton}" HorizontalAlignment="Stretch"
                                Command="{Binding ImportCommand}" />
                        <ProgressBar Minimum="0" Maximum="{Binding ImportProgressTotal}"
                                     Value="{Binding ImportProgressCurrent}" IsVisible="{Binding IsImporting}" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{StaticResource InkSecondaryBrush}" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding CurrentVersionLabel}" FontSize="12"
                                   Foreground="{StaticResource InkTertiaryBrush}" />
                        <CheckBox Content="{loc:Loc UpdateAutoCheck}"
                                  IsChecked="{Binding CheckForUpdatesAutomatically}" />
                        <Button Classes="secondary" Content="{loc:Loc UpdateCheckButton}" HorizontalAlignment="Stretch"
                                Command="{Binding CheckForUpdatesCommand}" />
                        <TextBlock Text="{Binding UpdateStatusMessage}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource InkSecondaryBrush}"
                                   IsVisible="{Binding UpdateStatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main content -->
        <Grid ColumnDefinitions="*,Auto">

            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Margin="28,24,28,4" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Loc PhotosTitle}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource InkPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding PhotosCountLabel}"
                               FontSize="13" Foreground="{StaticResource InkSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer>
                        <ListBox Classes="photoGrid" ItemsSource="{Binding Photos}"
                                 SelectedItem="{Binding SelectedPhoto}" Padding="20">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PhotoItemViewModel">
                                    <Border Classes="photoCard" Width="188" Height="222" Margin="8"
                                            CornerRadius="14" Background="{StaticResource SurfaceCardBrush}"
                                            BoxShadow="0 1 4 0 #14000000">
                                        <Grid RowDefinitions="146,*" Margin="12">
                                            <Grid Grid.Row="0">
                                                <Border CornerRadius="9" Background="{StaticResource SurfaceAppBrush}"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="6" Padding="9,3" CornerRadius="10"
                                                        IsVisible="{Binding HasStatusBadge}"
                                                        Background="{Binding Status, Converter={x:Static c:ImportStatusToBrushConverter.Instance}}">
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,9,0,0" Spacing="2">
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource InkPrimaryBrush}" />
                                                <TextBlock Text="{Binding CameraModel}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding HasCameraModel}"
                                                           Foreground="{StaticResource InkSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <StackPanel IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="10" MaxWidth="320">
                        <TextBlock Text="&#128247;" FontSize="40" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Loc EmptyStateTitle}" FontSize="15"
                                   FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource InkPrimaryBrush}" />
                        <TextBlock Text="{loc:Loc EmptyStateSubtitle}"
                                   FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource InkSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Width="320" IsVisible="{Binding SelectedPhoto, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                    Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <StackPanel Margin="24" Spacing="6" DataContext="{Binding SelectedPhoto}" x:DataType="vm:PhotoItemViewModel">
                        <TextBlock Classes="sectionLabel" Text="{loc:Loc DetailTitle}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasCameraMake}">
                            <TextBlock Text="{loc:Loc DetailMake}" FontSize="13" Width="90" Foreground="{StaticResource InkSecondaryBrush}" />
                            <TextBlock Text="{Binding CameraMake}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasCameraModel}">
                            <TextBlock Text="{loc:Loc DetailModel}" FontSize="13" Width="90" Foreground="{StaticResource InkSecondaryBrush}" />
                            <TextBlock Text="{Binding CameraModel}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasDateTaken}">
                            <TextBlock Text="{loc:Loc DetailDate}" FontSize="13" Width="90" Foreground="{StaticResource InkSecondaryBrush}" />
                            <TextBlock Text="{Binding DateTaken}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasDimensions}">
                            <TextBlock Text="{loc:Loc DetailDimensions}" FontSize="13" Width="90" Foreground="{StaticResource InkSecondaryBrush}" />
                            <TextBlock Text="{Binding Width, StringFormat='{}{0}px'}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkPrimaryBrush}" />
                            <TextBlock Text="×" FontSize="13" Foreground="{StaticResource InkSecondaryBrush}" />
                            <TextBlock Text="{Binding Height, StringFormat='{}{0}px'}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{loc:Loc DetailNoExifNote}"
                                   FontSize="12.5" FontStyle="Italic" TextWrapping="Wrap"
                                   Foreground="{StaticResource InkTertiaryBrush}"
                                   IsVisible="{Binding !HasAnyBasicExifInfo}" />

                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,14" />

                        <TextBlock Classes="sectionLabel" Text="{loc:Loc DetailAllTags}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding AllTags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11.5"
                                               Foreground="{StaticResource InkSecondaryBrush}" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>

</Window>
