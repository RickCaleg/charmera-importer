<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:charmera_importer.ViewModels"
        xmlns:loc="using:charmera_importer.Localization"
        x:Class="charmera_importer.Views.AboutWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/charmera-icon.ico"
        Title="{loc:Loc SettingsAbout}"
        Width="560" Height="720" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceCardBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Identity -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceHeaderBrush}" Padding="32,28">
            <Grid ColumnDefinitions="Auto,*">
                <Image Grid.Column="0" Source="/Assets/charmera-icon.png" Width="56" Height="56"
                       VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Charmera Importer" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding VersionOnlyLabel}" FontSize="12.5" Foreground="#9A9AA2" />
                    <TextBlock Text="{loc:Loc AboutTagline}" FontSize="13" Foreground="#D4D4D8"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="32,24" Spacing="24">

                <!-- The headline feature -->
                <Border Classes="charmeraBadge" Padding="18,16" CornerRadius="12">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource KodakRedBrush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc AboutCharmeraTitle}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource InkPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{loc:Loc AboutCharmeraBody}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource InkPrimaryBrush}" />
                        <StackPanel Spacing="6" Margin="4,0,0,0">
                            <StackPanel.Styles>
                                <Style Selector="TextBlock.fixItem">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
                                </Style>
                            </StackPanel.Styles>
                            <Grid ColumnDefinitions="18,*">
                                <Path Classes="lineIcon" Width="11" Height="9" Stroke="{StaticResource KodakRedBrush}"
                                      StrokeThickness="2" Data="M1,5 L4.5,8.5 L11,1" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBlock Grid.Column="1" Classes="fixItem" Text="{loc:Loc AboutFix1}" />
                            </Grid>
                            <Grid ColumnDefinitions="18,*">
                                <Path Classes="lineIcon" Width="11" Height="9" Stroke="{StaticResource KodakRedBrush}"
                                      StrokeThickness="2" Data="M1,5 L4.5,8.5 L11,1" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBlock Grid.Column="1" Classes="fixItem" Text="{loc:Loc AboutFix2}" />
                            </Grid>
                            <Grid ColumnDefinitions="18,*">
                                <Path Classes="lineIcon" Width="11" Height="9" Stroke="{StaticResource KodakRedBrush}"
                                      StrokeThickness="2" Data="M1,5 L4.5,8.5 L11,1" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBlock Grid.Column="1" Classes="fixItem" Text="{loc:Loc AboutFix3}" />
                            </Grid>
                            <Grid ColumnDefinitions="18,*">
                                <Path Classes="lineIcon" Width="11" Height="9" Stroke="{StaticResource KodakRedBrush}"
                                      StrokeThickness="2" Data="M1,5 L4.5,8.5 L11,1" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBlock Grid.Column="1" Classes="fixItem" Text="{loc:Loc AboutFix4}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Classes="caption" FontSize="12" Text="{loc:Loc AboutCharmeraFootnote}" />
                    </StackPanel>
                </Border>

                <!-- Features -->
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Loc AboutFeaturesTitle}" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource InkPrimaryBrush}" />
                    <StackPanel Spacing="7">
                        <StackPanel.Styles>
                            <Style Selector="TextBlock.feature">
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
                            </Style>
                            <Style Selector="Border.bullet">
                                <Setter Property="Width" Value="5" />
                                <Setter Property="Height" Value="5" />
                                <Setter Property="CornerRadius" Value="3" />
                                <Setter Property="Background" Value="{StaticResource InkTertiaryBrush}" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="0,7,0,0" />
                            </Style>
                        </StackPanel.Styles>
                        <Grid ColumnDefinitions="18,*"><Border Classes="bullet" /><TextBlock Grid.Column="1" Classes="feature" Text="{loc:Loc AboutFeature1}" /></Grid>
                        <Grid ColumnDefinitions="18,*"><Border Classes="bullet" /><TextBlock Grid.Column="1" Classes="feature" Text="{loc:Loc AboutFeature2}" /></Grid>
                        <Grid ColumnDefinitions="18,*"><Border Classes="bullet" /><TextBlock Grid.Column="1" Classes="feature" Text="{loc:Loc AboutFeature3}" /></Grid>
                        <Grid ColumnDefinitions="18,*"><Border Classes="bullet" /><TextBlock Grid.Column="1" Classes="feature" Text="{loc:Loc AboutFeature4}" /></Grid>
                        <Grid ColumnDefinitions="18,*"><Border Classes="bullet" /><TextBlock Grid.Column="1" Classes="feature" Text="{loc:Loc AboutFeature5}" /></Grid>
                        <Grid ColumnDefinitions="18,*"><Border Classes="bullet" /><TextBlock Grid.Column="1" Classes="feature" Text="{loc:Loc AboutFeature6}" /></Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Privacy -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc AboutPrivacyTitle}" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource InkPrimaryBrush}" />
                    <TextBlock Classes="caption" FontSize="13" Text="{loc:Loc AboutPrivacyBody}" />
                </StackPanel>

                <!-- Links -->
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <Button Classes="secondary compact" Content="{loc:Loc AboutLinkSource}"
                            Tag="https://github.com/RickCaleg/charmera-importer" Click="OnLinkClicked" />
                    <Button Classes="secondary compact" Content="{loc:Loc AboutLinkIssue}"
                            Tag="https://github.com/RickCaleg/charmera-importer/issues/new/choose" Click="OnLinkClicked" />
                    <Button Classes="secondary compact" Content="{loc:Loc AboutLinkLicense}"
                            Tag="https://github.com/RickCaleg/charmera-importer/blob/main/LICENSE" Click="OnLinkClicked" />
                    <Button Classes="secondary compact" Content="{loc:Loc AboutLinkNotices}"
                            Tag="https://github.com/RickCaleg/charmera-importer/blob/main/THIRD-PARTY-NOTICES.md" Click="OnLinkClicked" />
                </WrapPanel>

                <TextBlock Classes="caption" FontSize="11.5" Foreground="{StaticResource InkTertiaryBrush}"
                           Text="{loc:Loc AboutCredits}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="32,14">
            <Button Classes="secondary" HorizontalAlignment="Right" Content="{loc:Loc AboutClose}"
                    Click="OnCloseClicked" IsDefault="True" IsCancel="True" />
        </Border>
    </Grid>
</Window>
